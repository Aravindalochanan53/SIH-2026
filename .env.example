# ============================================================
# TRANSLARA AI — ENVIRONMENT CONFIGURATION
# ============================================================

# Application Environment (development / production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Operational Modes
# Set MOCK_MODE=false to enable real model inference (IndicTrans2, Faster-Whisper, IndicTTS)
MOCK_MODE=true
DEMO_MODE=false

# Compute Device ('cpu', 'cuda', 'auto')
DEVICE=auto

# ------------------------------------------------------------
# MODULE 1 & 2: LOCAL ASR (Speech-to-Text)
# ------------------------------------------------------------
ASR_BACKEND=local_asr
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
ASR_TIMEOUT_MS=1200

# ------------------------------------------------------------
# MODULE 3 & 4: LOCAL TRANSLATION (NMT)
# ------------------------------------------------------------
NMT_BACKEND=local_nmt
INDICTRANS2_MODEL_ID=ai4bharat/indictrans2-indic-indic-dist-320M
NMT_TIMEOUT_MS=1400

# ------------------------------------------------------------
# MODULE 10: LOCAL TTS (Text-to-Speech)
# ------------------------------------------------------------
TTS_BACKEND=local_tts
TTS_TIMEOUT_MS=1000

# ------------------------------------------------------------
# STORAGE & LOCAL TRAINED MODEL PATHS
# ------------------------------------------------------------
TRAINED_MODELS_DIR=./trained_models
TRAINED_TRANSLATION_MODEL_DIR=./trained_models/translation
TRAINED_ASR_MODEL_DIR=./trained_models/asr
TRAINED_NER_MODEL_DIR=./trained_models/ner
TRAINED_TTS_MODEL_DIR=./trained_models/tts

DATABASE_URL=mssql+pyodbc:///?odbc_connect=Driver%3D%7BODBC+Driver+17+for+SQL+Server%7D%3BServer%3Dlocalhost%5CMSSQL%3BDatabase%3DTranslara%3BTrusted_Connection%3Dyes%3BTrustServerCertificate%3Dyes
DATA_DIR=./data
MODEL_CACHE_DIR=./models

# ============================================================
# TRANSLARA AI — ENVIRONMENT CONFIGURATION
# ============================================================

# Application Environment (development / production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Operational Modes
# Set MOCK_MODE=false to enable real model inference (IndicTrans2, Faster-Whisper, IndicTTS)
MOCK_MODE=true
DEMO_MODE=false

# Compute Device ('cpu', 'cuda', 'auto')
DEVICE=auto

# ------------------------------------------------------------
# MODULE 1 & 2: ASR (Automatic Speech Recognition)
# ------------------------------------------------------------
ASR_BACKEND=faster_whisper
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
ASR_TIMEOUT_MS=1200
INDIC_CONFORMER_ENDPOINT=http://localhost:8001/asr/v1/recognize

# ------------------------------------------------------------
# MODULE 3 & 4: TRANSLATION & NMT BACKENDS
# ------------------------------------------------------------
# Priority: indictrans2 -> bhashini_ulca -> offline
NMT_BACKEND=indictrans2
INDICTRANS2_MODEL_ID=ai4bharat/indictrans2-indic-indic-dist-320M
NMT_TIMEOUT_MS=1400

# Government of India Bhashini ULCA API Credentials (Optional)
BHASHINI_API_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_USER_ID=
BHASHINI_INFERENCE_API_KEY=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_ID=

# ------------------------------------------------------------
# MODULE 10: TTS (Text-to-Speech)
# ------------------------------------------------------------
TTS_BACKEND=indic_tts
INDIC_TTS_ENDPOINT=http://localhost:8002/tts/v1/synthesize
TTS_TIMEOUT_MS=1000

# ------------------------------------------------------------
# STORAGE & PATHS
# ------------------------------------------------------------
DATABASE_URL=sqlite:///./data/translara.db
DATA_DIR=./data
MODEL_CACHE_DIR=./models_cache

# ============================================================
# TRANSLARA FRONTEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# ============================================================
# NOTE: The frontend communicates ONLY with the FastAPI backend.
# NEVER put MSSQL credentials, database passwords, or JWT secrets in frontend .env!

VITE_APP_NAME=TRANSLARA
VITE_APP_ENV=development
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

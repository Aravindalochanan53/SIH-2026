# ============================================================
# TRANSLARA BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# ============================================================

APP_NAME=TRANSLARA
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------
# MICROSOFT SQL SERVER (MSSQL) CONFIGURATION
# ------------------------------------------------------------
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=TRANSLARA
DB_USER=YOUR_SQL_USERNAME
DB_PASSWORD=YOUR_SQL_PASSWORD
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true

# Optional Direct DATABASE_URL (takes precedence if provided)
DATABASE_URL=mssql+pyodbc://YOUR_SQL_USERNAME:YOUR_SQL_PASSWORD@localhost:1433/TRANSLARA?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ------------------------------------------------------------
# SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------
# CORS & NETWORKING
# ------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------
# TRANSLARA AI ENGINE & STORAGE
# ------------------------------------------------------------
AI_MODEL_DIR=./models
DATA_DIR=./data

MOCK_MODE=false
DEMO_MODE=false
